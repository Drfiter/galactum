[gd_scene format=3]

[ext_resource type="Script" path="res://app/main.gd" id="1_main"]
[ext_resource type="Script" path="res://modules/team3/network/sss_connection.gd" id="2_connection"]
[ext_resource type="Script" path="res://modules/team3/world/world_debug_view.gd" id="3_world_view"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="SssConnection" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("2_connection")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.018, 0.035, 0.065, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Galactum · TEAM3-M0"

[node name="Subtitle" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "Vista diagnóstica cliente → WebSocket → SSS headless"

[node name="ConnectionRow" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="HostLabel" type="Label" parent="Margin/Content/ConnectionRow"]
layout_mode = 2
text = "Host"

[node name="HostEdit" type="LineEdit" parent="Margin/Content/ConnectionRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(180, 48)
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "127.0.0.1 o IP LAN"

[node name="PortLabel" type="Label" parent="Margin/Content/ConnectionRow"]
layout_mode = 2
text = "Puerto"

[node name="PortEdit" type="SpinBox" parent="Margin/Content/ConnectionRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 48)
layout_mode = 2
min_value = 1.0
max_value = 65535.0
value = 9100.0
allow_greater = false
allow_lesser = false

[node name="ConnectButton" type="Button" parent="Margin/Content/ConnectionRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(140, 48)
layout_mode = 2
text = "Conectar"

[node name="StatusLabel" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "SSS: desconectado"

[node name="MetadataLabel" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2
text = "protocol=— · seq=— · server_time=—"

[node name="ShipLabel" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2
text = "Nave dummy: esperando full_snapshot"

[node name="WorldDebugView" type="Control" parent="Margin/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 240)
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2
script = ExtResource("3_world_view")
